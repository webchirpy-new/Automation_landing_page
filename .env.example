# Copy to .env.local (or .env.production) — never commit real values.
# Only VITE_* variables are exposed to the browser.

# Booking form endpoint (POST JSON). Leave empty → form runs in labelled demo mode.
VITE_FORM_ENDPOINT=

# Contact (DOCX placeholders: PLACEHOLDER_PHONE / PLACEHOLDER_WHATSAPP_NUMBER)
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=

# Approved video EMBED URLs (e.g. https://www.youtube-nocookie.com/embed/<id>)
VITE_FOUNDER_VIDEO_URL=
VITE_TESTIMONIAL_VIDEO_URL=

# Legal pages — only real, published policies
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Feature flags
VITE_ENABLE_EXIT_POPUP=true
# Client voices + project gallery (testimonials): shown by default, set false to hide
VITE_SHOW_CLIENT_STORIES=true
# Only set true once the client approves the hero "Source:" line wording
VITE_SHOW_HERO_SOURCE_LINE=false

